{
  "welcomeFile": "/airlinedashboard/index.html",
  "authenticationMethod": "route",
  "routes": [
    {
      "source": "^/odata/(.*)$",
      "target": "/odata/$1",
      "destination": "srv-api",
      "authenticationType": "xsuaa",
      "csrfProtection": false
    },
    {
      "source": "^/(airlinedashboard|monthlytrend|weekdaytrend|brandoperator|aiaudit)/(.*)$",
      "target": "/$1/$2",
      "localDir": "resources",
      "authenticationType": "xsuaa"
    },
    {
      "source": "^/(.*)$",
      "target": "/$1",
      "localDir": "resources",
      "authenticationType": "xsuaa"
    }
  ]
}
