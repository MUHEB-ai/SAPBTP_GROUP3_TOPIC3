{
  "name": "Topic_3",
  "version": "1.0.0",
  "dependencies": {
    "@cap-js/hana": "^2",
    "@sap-cloud-sdk/http-client": "^4.7.0",
    "@sap-cloud-sdk/util": "^4.7.0",
    "@sap/cds": "^9",
    "@sap/low-code-event-handler": "^1.2.5",
    "@sap/xsenv": ">=3.3.2 <3.3.3",
    "@sap/xssec": "^4",
    "better-sqlite3": "^12.11.1",
    "csv-parse": "^6.2.1",
    "csv-stringify": "^6.7.0",
    "hdb": "^2.27.1",
    "passport": "^0.7.0"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^2.4.0",
    "@sap/cds-dk": "^9",
    "@sap/dev-cap-tools": "^1.31.0",
    "cds-plugin-ui5": "^0.13.0"
  },
  "scripts": {
    "start": "cds-serve",
    "start-local": "npm run generate-entry-point && npm run cds-watch",
    "generate-entry-point": "dev-cap-tools gen-entrypoint",
    "cds-watch": "cds watch --open",
    "watch-airlinedashboard": "cds watch --open ns.airlinedashboard/index.html?sap-ui-xx-viewCache=false --livereload false",
    "watch-monthlytrend": "cds watch --open ns.monthlytrend/index.html?sap-ui-xx-viewCache=false --livereload false",
    "watch-weekdaytrend": "cds watch --open ns.weekdaytrend/index.html?sap-ui-xx-viewCache=false --livereload false",
    "watch-brandoperator": "cds watch --open ns.brandoperator/index.html?sap-ui-xx-viewCache=false --livereload false"
  },
  "private": true,
  "cds": {
    "requires": {
      "db": {
        "kind": "sqlite",
        "credentials": {
          "url": "db/flights.sqlite"
        }
      },
      "[production]": {
        "db": "hana",
        "auth": "xsuaa"
      },
      "auth": {
        "[development]": {
          "kind": "dummy"
        },
        "[production]": {
          "kind": "xsuaa"
        }
      }
    }
  },
  "lcap": true,
  "workspaces": [
    "app/*"
  ],
  "sapux": [
    "app/airlinedashboard",
    "app/monthlytrend",
    "app/weekdaytrend",
    "app/brandoperator",
    "app/aiaudit"
  ]
}
